    ['type' => 'lowercase',  'value' => 1,  'label_key' => 'rule_lowercase'],
    ['type' => 'digit',      'value' => 1,  'label_key' => 'rule_digit'],
    ['type' => 'special',    'value' => 1,  'label_key' => 'rule_special'],
